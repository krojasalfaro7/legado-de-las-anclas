{
  "name": "legado-de-las-anclas",
  "version": "1.0.0",
  "description": "Fan game top-down action-RPG (vertical slice)",
  "scripts": {
    "predev": "node scripts/check-sprites.ts --no-fail",
    "dev": "vite",
    "prebuild": "node scripts/check-sprites.ts --no-fail",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p .",
    "assets": "node scripts/gen-tileset.ts && node scripts/build-maps.ts",
    "sprites:check": "node scripts/check-sprites.ts",
    "sprites:templates": "node scripts/gen-sprite-templates.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
